# .env.example
# Copy to .env and fill in, then: docker compose up -d
# (no repo checkout needed — docker-compose.yml + .env is enough)

# --- Required ---
BOT_TOKEN=your_bot_token
BASE_URL=your.domain.example

# --- Telegram Instant View (optional) ---
# Leave empty: watch links use a themed og:video page (Telegram's native
# link-preview player, no approval needed).
# Set: the rhash from an Instant View template you created for BASE_URL at
# https://instantview.telegram.org — watch links become t.me/iv?... and open
# in true Instant View.
IV_RHASH=

# --- Image ---
IMAGE_TAG=latest

# --- Networking / Traefik ---
PUBLIC_PORT=80:80
LETSENCRYPT_RESOLVER_NAME=letsencrypt-cloudflare-dns-challenge

# --- Storage ---
# Host directory holding /config (cookie files) for the app container.
GLOBAL_DATA_FOLDER=/Data

# --- Cache cleanup (cron service) ---
FILE_TTL=3
FILE_TTL_TYPE=mtime

# --- App settings ---
LOG_LEVEL=INFO
CACHE_DIR=/tmp/url-fairy-bot-cache/
COOKIES_DIR=/config/
COOKIE_JAR_ENABLED=false
FOLLOW_REDIRECT_TIMEOUT=10
DOWNLOAD_ALLOWED_DOMAINS=
REWRITE_ALLOWED_DOMAINS=

# --- Mirror domains (all optional, defaults shown) ---
SPOTIFY_MIRROR_DOMAIN=fxspotify.com
INSTAGRAM_MIRROR_DOMAIN=kkinstagram.com
REDDIT_MIRROR_DOMAIN=rxddit.com
THREADS_MIRROR_DOMAIN=fx.akitsuki.me
TIKTOK_MIRROR_DOMAIN=tfxktok.com
TWITTER_MIRROR_DOMAIN=fxtwitter.com
YOUTUBE_MIRROR_DOMAIN=yfxtube.com
YOUTUBE_SHORT_MIRROR_DOMAIN=fxyoutu.be
