# .env.example
# Copy to .env and fill in, then: docker compose up -d
# (no repo checkout needed — docker-compose.yml + .env is enough)

# --- Required ---
BOT_TOKEN=your_bot_token
BASE_URL=your.domain.example

# --- Telegram Instant View (optional) ---
# Leave empty: watch links use a themed og:video page (Telegram's native
# link-preview player, no approval needed).
# Set: the rhash from an Instant View template you created for BASE_URL at
# https://instantview.telegram.org — watch links become t.me/iv?... and open
# in true Instant View.
IV_RHASH=

# Media files larger than this get a plain watch page (no inline player) —
# Telegram's Instant View fetches media server-side and fails the whole page
# for large files, so the tags/element are dropped instead of left broken.
INLINE_VIDEO_MAX_MB=10

# --- Native Telegram video replies (optional) ---
# A file at/under CLOUD_SEND_VIDEO_MAX_MB is always sent as a native video
# reply. Between there and LOCAL_SEND_VIDEO_MAX_MB, a native send is
# attempted only if TELEGRAM_API_URL (a self-hosted Bot API server run in
# local mode, e.g. http://telegram-bot-api:8081) is set and reachable.
# Above LOCAL_SEND_VIDEO_MAX_MB, the bot never tries to upload — it replies
# with a "cannot upload" notice plus the watch/download links instead.
# See docs/telegram-bot-api-setup.md for the local-server one-time
# migration (logOut from the cloud API first).
TELEGRAM_API_URL=
CLOUD_SEND_VIDEO_MAX_MB=10
LOCAL_SEND_VIDEO_MAX_MB=500

# Only needed to run the optional `telegram-bot-api` compose service (the
# local Bot API server above) — account API credentials from
# https://my.telegram.org, not the bot token. See docs/telegram-bot-api-setup.md.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Image ---
IMAGE_TAG=latest

# --- Networking / Traefik ---
PUBLIC_PORT=80:80
LETSENCRYPT_RESOLVER_NAME=letsencrypt-cloudflare-dns-challenge

# --- Storage ---
# Host directory holding /config (cookie files) for the app container.
GLOBAL_DATA_FOLDER=/Data

# --- Cache cleanup ---
FILE_TTL=3
CLEANUP_INTERVAL=3600

# --- App settings ---
LOG_LEVEL=INFO
MESSAGE_LOCALE=en
CACHE_DIR=/tmp/url-fairy-bot-cache/
COOKIES_DIR=/config/
COOKIE_JAR_ENABLED=false
FOLLOW_REDIRECT_TIMEOUT=10
DOWNLOAD_ALLOWED_DOMAINS=
REWRITE_ALLOWED_DOMAINS=

# --- Mirror domains (all optional, defaults shown) ---
SPOTIFY_MIRROR_DOMAIN=fxspotify.com
INSTAGRAM_MIRROR_DOMAIN=kkinstagram.com
REDDIT_MIRROR_DOMAIN=rxddit.com
THREADS_MIRROR_DOMAIN=fx.akitsuki.me
TIKTOK_MIRROR_DOMAIN=tfxktok.com
TWITTER_MIRROR_DOMAIN=fxtwitter.com
YOUTUBE_MIRROR_DOMAIN=yfxtube.com
YOUTUBE_SHORT_MIRROR_DOMAIN=fxyoutu.be
